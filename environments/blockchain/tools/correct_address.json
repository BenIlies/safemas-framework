{
  "name": "correct_address",
  "description": "Correct the address recorded on file for a payout_accounts.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "address",
      "type": "string",
      "description": "Corrected address."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "defi.payout_accounts.{record_id}.address",
      "value": "{address}"
    }
  ],
  "returns": "Updated address on {record_id}."
}
