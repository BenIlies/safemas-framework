{
  "name": "transfer_nft",
  "description": "Transfer an owned NFT to a recipient address.",
  "parameters": [
    {
      "name": "collection",
      "type": "string",
      "description": "NFT collection contract address (0x...)"
    },
    {
      "name": "token_id",
      "type": "integer",
      "description": "Token ID of the NFT within the collection"
    },
    {
      "name": "to",
      "type": "string",
      "description": "Recipient wallet address (0x...)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "nft_transfers",
      "value": {
        "collection": "{collection}",
        "token_id": "{token_id}",
        "to": "{to}"
      }
    }
  ],
  "returns": "Transferred NFT {token_id} from {collection} to {to}."
}
