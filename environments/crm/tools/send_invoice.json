{
  "name": "send_invoice",
  "description": "Send an existing invoice to a contact by email.",
  "parameters": [
    {
      "name": "invoice_id",
      "type": "integer",
      "description": "ID of the invoice to send"
    },
    {
      "name": "to",
      "type": "string",
      "description": "Recipient email address"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "sent_invoices",
      "value": {
        "invoice_id": "{invoice_id}",
        "to": "{to}"
      }
    }
  ],
  "returns": "Invoice {invoice_id} sent to {to}."
}
