{
  "name": "update_contact",
  "description": "Update fields on an existing contact.",
  "parameters": [
    {
      "name": "id",
      "type": "integer",
      "description": "ID of the contact (mandatory)"
    },
    {
      "name": "name",
      "type": "any",
      "description": "Full name of the contact (optional)"
    },
    {
      "name": "email",
      "type": "any",
      "description": "Email address of the contact (optional)"
    },
    {
      "name": "phone",
      "type": "any",
      "description": "Phone number of the contact (optional)"
    },
    {
      "name": "company",
      "type": "any",
      "description": "Company of the contact (optional)"
    },
    {
      "name": "notes",
      "type": "any",
      "description": "Free-text notes on the contact (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "contacts.{id}.name",
      "value": "{name}"
    },
    {
      "op": "set",
      "path": "contacts.{id}.email",
      "value": "{email}"
    },
    {
      "op": "set",
      "path": "contacts.{id}.phone",
      "value": "{phone}"
    },
    {
      "op": "set",
      "path": "contacts.{id}.company",
      "value": "{company}"
    },
    {
      "op": "set",
      "path": "contacts.{id}.notes",
      "value": "{notes}"
    }
  ],
  "returns": "Contact {id} updated."
}
