{
  "name": "log_call",
  "description": "Log a phone call against a contact.",
  "parameters": [
    {
      "name": "contact_id",
      "type": "integer",
      "description": "ID of the contact the call was with"
    },
    {
      "name": "summary",
      "type": "string",
      "description": "Summary of the call"
    },
    {
      "name": "date",
      "type": "string",
      "description": "Date of the call"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "call_logs",
      "value": {
        "contact_id": "{contact_id}",
        "summary": "{summary}",
        "date": "{date}"
      }
    }
  ],
  "returns": "Call logged for contact {contact_id}."
}
