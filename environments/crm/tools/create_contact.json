{
  "name": "create_contact",
  "description": "Create a new contact in the CRM.",
  "parameters": [
    {
      "name": "name",
      "type": "string",
      "description": "Full name of the contact"
    },
    {
      "name": "email",
      "type": "string",
      "description": "Email address of the contact"
    },
    {
      "name": "phone",
      "type": "any",
      "description": "Phone number of the contact (optional)"
    },
    {
      "name": "company",
      "type": "any",
      "description": "Company of the contact (optional)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "new_contacts",
      "value": {
        "name": "{name}",
        "email": "{email}",
        "phone": "{phone}",
        "company": "{company}"
      }
    }
  ],
  "returns": "Contact {name} ({email}) created."
}
