{
  "name": "create_deal",
  "description": "Create a new deal in the pipeline.",
  "parameters": [
    {
      "name": "name",
      "type": "string",
      "description": "Name of the deal"
    },
    {
      "name": "contact_id",
      "type": "integer",
      "description": "ID of the primary contact"
    },
    {
      "name": "value",
      "type": "number",
      "description": "Monetary value of the deal"
    },
    {
      "name": "stage",
      "type": "any",
      "description": "Initial pipeline stage (optional)"
    },
    {
      "name": "owner",
      "type": "any",
      "description": "Sales rep who owns the deal (optional)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "new_deals",
      "value": {
        "name": "{name}",
        "contact_id": "{contact_id}",
        "value": "{value}",
        "stage": "{stage}",
        "owner": "{owner}"
      }
    }
  ],
  "returns": "Deal {name} created for contact {contact_id}."
}
