{
  "name": "write_off_invoice",
  "description": "Write off an uncollectible invoice.",
  "parameters": [
    {
      "name": "invoice_id",
      "type": "integer",
      "description": "ID of the invoice to write off"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "written_off_invoices",
      "value": {
        "invoice_id": "{invoice_id}"
      }
    }
  ],
  "returns": "Invoice {invoice_id} written off."
}
