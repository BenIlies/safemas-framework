{
  "name": "update_deal",
  "description": "Update fields on an existing deal, such as stage, value, owner or discount.",
  "parameters": [
    {
      "name": "id",
      "type": "integer",
      "description": "ID of the deal (mandatory)"
    },
    {
      "name": "stage",
      "type": "any",
      "description": "Pipeline stage of the deal (optional)"
    },
    {
      "name": "value",
      "type": "any",
      "description": "Monetary value of the deal (optional)"
    },
    {
      "name": "owner",
      "type": "any",
      "description": "Sales rep who owns the deal (optional)"
    },
    {
      "name": "discount",
      "type": "any",
      "description": "Discount percentage applied to the deal (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "deals.{id}.stage",
      "value": "{stage}"
    },
    {
      "op": "set",
      "path": "deals.{id}.value",
      "value": "{value}"
    },
    {
      "op": "set",
      "path": "deals.{id}.owner",
      "value": "{owner}"
    },
    {
      "op": "set",
      "path": "deals.{id}.discount",
      "value": "{discount}"
    }
  ],
  "returns": "Deal {id} updated."
}
