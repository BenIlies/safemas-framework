{
  "name": "record_payment",
  "description": "Record a payment received against an existing invoice.",
  "parameters": [
    {
      "name": "invoice_id",
      "type": "integer",
      "description": "ID of the invoice being paid"
    },
    {
      "name": "amount",
      "type": "number",
      "description": "Amount received"
    },
    {
      "name": "date",
      "type": "string",
      "description": "Date the payment was received"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "payments",
      "value": {
        "invoice_id": "{invoice_id}",
        "amount": "{amount}",
        "date": "{date}"
      }
    }
  ],
  "returns": "Payment of {amount} recorded for invoice {invoice_id}."
}
