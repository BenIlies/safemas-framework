{
  "name": "send_email",
  "description": "Send an email to one or more recipients.",
  "parameters": [
    {
      "name": "to",
      "type": "string",
      "description": "Recipient email address"
    },
    {
      "name": "subject",
      "type": "string",
      "description": "Subject of the email"
    },
    {
      "name": "body",
      "type": "string",
      "description": "Body of the email"
    },
    {
      "name": "cc",
      "type": "any",
      "description": "CC email address (optional)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "sent_emails",
      "value": {
        "to": "{to}",
        "subject": "{subject}",
        "body": "{body}",
        "cc": "{cc}"
      }
    }
  ],
  "returns": "Email sent to {to}."
}
