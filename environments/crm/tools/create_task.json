{
  "name": "create_task",
  "description": "Create a follow-up task.",
  "parameters": [
    {
      "name": "title",
      "type": "string",
      "description": "Title of the task"
    },
    {
      "name": "due_date",
      "type": "string",
      "description": "Due date of the task"
    },
    {
      "name": "contact_id",
      "type": "any",
      "description": "ID of the related contact (optional)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "new_tasks",
      "value": {
        "title": "{title}",
        "due_date": "{due_date}",
        "contact_id": "{contact_id}"
      }
    }
  ],
  "returns": "Task '{title}' created."
}
