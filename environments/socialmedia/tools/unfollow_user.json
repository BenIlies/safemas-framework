{
  "name": "unfollow_user",
  "description": "Unfollow an account by handle.",
  "parameters": [
    {
      "name": "handle",
      "type": "string",
      "description": "Handle of the account to unfollow"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "unfollowed",
      "value": {
        "handle": "{handle}"
      }
    }
  ],
  "returns": "Unfollowed {handle}."
}
