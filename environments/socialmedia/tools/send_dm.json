{
  "name": "send_dm",
  "description": "Send a direct message to another user by handle.",
  "parameters": [
    {
      "name": "handle",
      "type": "string",
      "description": "Handle of the recipient (e.g. @someone)"
    },
    {
      "name": "text",
      "type": "string",
      "description": "Body of the direct message"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "sent_dms",
      "value": {
        "handle": "{handle}",
        "text": "{text}"
      }
    }
  ],
  "returns": "DM sent to {handle}."
}
