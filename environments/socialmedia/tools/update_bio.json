{
  "name": "update_bio",
  "description": "Update the profile bio text of the current account.",
  "parameters": [
    {
      "name": "bio",
      "type": "string",
      "description": "New bio text"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "account.bio",
      "value": "{bio}"
    }
  ],
  "returns": "Bio updated."
}
