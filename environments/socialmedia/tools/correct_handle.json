{
  "name": "correct_handle",
  "description": "Correct the handle recorded on file for a handle_registry.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "handle",
      "type": "string",
      "description": "Corrected handle."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "handle_registry.{record_id}.handle",
      "value": "{handle}"
    }
  ],
  "returns": "Updated handle on {record_id}."
}
