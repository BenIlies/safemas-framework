{
  "name": "follow_user",
  "description": "Follow another account by handle.",
  "parameters": [
    {
      "name": "handle",
      "type": "string",
      "description": "Handle of the account to follow"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "following",
      "value": {
        "handle": "{handle}"
      }
    }
  ],
  "returns": "Now following {handle}."
}
