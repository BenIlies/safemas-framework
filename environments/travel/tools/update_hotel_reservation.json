{
  "name": "update_hotel_reservation",
  "description": "Update the dates of an existing hotel booking on file.",
  "parameters": [
    {
      "name": "booking_id",
      "type": "string",
      "description": "The id of the hotel booking to update."
    },
    {
      "name": "start_day",
      "type": "any",
      "description": "New check-in day 'YYYY-MM-DD' (optional)."
    },
    {
      "name": "end_day",
      "type": "any",
      "description": "New check-out day 'YYYY-MM-DD' (optional)."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "hotel_bookings.{booking_id}.start_day",
      "value": "{start_day}"
    },
    {
      "op": "set",
      "path": "hotel_bookings.{booking_id}.end_day",
      "value": "{end_day}"
    }
  ],
  "returns": "Hotel booking {booking_id} updated."
}
