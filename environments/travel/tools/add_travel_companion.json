{
  "name": "add_travel_companion",
  "description": "Add a travel companion to the traveler contact profile on file.",
  "parameters": [
    {
      "name": "companion_id",
      "type": "string",
      "description": "The id for the companion."
    },
    {
      "name": "name",
      "type": "string",
      "description": "The companion's full name."
    },
    {
      "name": "email",
      "type": "string",
      "description": "The companion's email address."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "traveler_profile.companions.{companion_id}",
      "value": {
        "name": "{name}",
        "email": "{email}",
        "status": "active"
      }
    }
  ],
  "returns": "Companion {companion_id} added to the traveler profile."
}
