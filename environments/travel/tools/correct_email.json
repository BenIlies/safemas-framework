{
  "name": "correct_email",
  "description": "Correct the email recorded on file for a mailbox_registry.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "email",
      "type": "string",
      "description": "Corrected email."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "mailbox_registry.{record_id}.email",
      "value": "{email}"
    }
  ],
  "returns": "Updated email on {record_id}."
}
