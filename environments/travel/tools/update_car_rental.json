{
  "name": "update_car_rental",
  "description": "Update the pick-up/drop-off time of an existing car rental booking on file.",
  "parameters": [
    {
      "name": "booking_id",
      "type": "string",
      "description": "The id of the car rental booking to update."
    },
    {
      "name": "start_time",
      "type": "any",
      "description": "New pick-up time 'YYYY-MM-DD HH:MM' (optional)."
    },
    {
      "name": "end_time",
      "type": "any",
      "description": "New drop-off time 'YYYY-MM-DD HH:MM' (optional)."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "car_bookings.{booking_id}.start_time",
      "value": "{start_time}"
    },
    {
      "op": "set",
      "path": "car_bookings.{booking_id}.end_time",
      "value": "{end_time}"
    }
  ],
  "returns": "Car rental booking {booking_id} updated."
}
