{
  "name": "place_stop_order",
  "description": "Place a stop order to buy or sell shares once the market reaches a stop (trigger) price.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol to trade"
    },
    {
      "name": "side",
      "type": "string",
      "description": "Order side, either 'buy' or 'sell'"
    },
    {
      "name": "quantity",
      "type": "number",
      "description": "Number of shares to trade"
    },
    {
      "name": "stop_price",
      "type": "number",
      "description": "Stop (trigger) price for the order"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "order_log",
      "value": {
        "ticker": "{ticker}",
        "side": "{side}",
        "quantity": "{quantity}",
        "type": "stop",
        "stop_price": "{stop_price}"
      }
    }
  ],
  "returns": "Placed stop {side} order for {quantity} {ticker} triggering at {stop_price}."
}
