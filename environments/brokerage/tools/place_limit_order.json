{
  "name": "place_limit_order",
  "description": "Place a limit order to buy or sell shares at a specified limit price.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol to trade"
    },
    {
      "name": "side",
      "type": "string",
      "description": "Order side, either 'buy' or 'sell'"
    },
    {
      "name": "quantity",
      "type": "number",
      "description": "Number of shares to trade"
    },
    {
      "name": "limit_price",
      "type": "number",
      "description": "Limit price for the order"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "order_log",
      "value": {
        "ticker": "{ticker}",
        "side": "{side}",
        "quantity": "{quantity}",
        "type": "limit",
        "limit_price": "{limit_price}"
      }
    }
  ],
  "returns": "Placed limit {side} order for {quantity} {ticker} at {limit_price}."
}
