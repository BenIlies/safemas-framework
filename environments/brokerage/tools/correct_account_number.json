{
  "name": "correct_account_number",
  "description": "Correct the account number recorded on file for a account_registry.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "account_number",
      "type": "string",
      "description": "Corrected account number."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "account_registry.{record_id}.account_number",
      "value": "{account_number}"
    }
  ],
  "returns": "Updated account_number on {record_id}."
}
