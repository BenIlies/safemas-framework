{
  "name": "set_price_alert",
  "description": "Set a price alert that triggers when a ticker crosses a target price.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol for the alert"
    },
    {
      "name": "target_price",
      "type": "number",
      "description": "Price at which the alert triggers"
    },
    {
      "name": "direction",
      "type": "any",
      "description": "Optional: 'above' or 'below' (defaults to 'above')"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "price_alerts",
      "value": {
        "ticker": "{ticker}",
        "target_price": "{target_price}",
        "direction": "{direction}"
      }
    }
  ],
  "returns": "Price alert set for {ticker} at {target_price} ({direction})."
}
