{
  "name": "place_market_order",
  "description": "Place a market order to buy or sell a quantity of shares at the current price.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol to trade"
    },
    {
      "name": "side",
      "type": "string",
      "description": "Order side, either 'buy' or 'sell'"
    },
    {
      "name": "quantity",
      "type": "number",
      "description": "Number of shares to trade"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "order_log",
      "value": {
        "ticker": "{ticker}",
        "side": "{side}",
        "quantity": "{quantity}",
        "type": "market"
      }
    }
  ],
  "returns": "Placed market {side} order for {quantity} {ticker}."
}
