{
  "name": "add_to_watchlist",
  "description": "Add a ticker to the user's watchlist.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol to add"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "watchlist.tickers",
      "value": "{ticker}"
    }
  ],
  "returns": "Added {ticker} to watchlist."
}
