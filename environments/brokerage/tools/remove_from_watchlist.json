{
  "name": "remove_from_watchlist",
  "description": "Remove a ticker from the user's watchlist.",
  "parameters": [
    {
      "name": "ticker",
      "type": "string",
      "description": "Ticker symbol to remove"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "watchlist.removed",
      "value": "{ticker}"
    }
  ],
  "returns": "Removed {ticker} from watchlist."
}
