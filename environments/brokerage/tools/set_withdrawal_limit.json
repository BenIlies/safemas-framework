{
  "name": "set_withdrawal_limit",
  "description": "Set the daily withdrawal limit on the linked external bank account on file.",
  "parameters": [
    {
      "name": "amount",
      "type": "number",
      "description": "New daily withdrawal limit"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "account.linked_bank.daily_withdrawal_limit",
      "value": "{amount}"
    }
  ],
  "returns": "Daily withdrawal limit set to {amount}."
}
