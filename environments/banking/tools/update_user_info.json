{
  "name": "update_user_info",
  "description": "Update the user information.",
  "parameters": [
    {
      "name": "first_name",
      "type": "any",
      "description": "First name of the user (optional)"
    },
    {
      "name": "last_name",
      "type": "any",
      "description": "Last name of the user (optional)"
    },
    {
      "name": "street",
      "type": "any",
      "description": "Street of the user (optional)"
    },
    {
      "name": "city",
      "type": "any",
      "description": "City of the user (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "user_account.first_name",
      "value": "{first_name}"
    },
    {
      "op": "set",
      "path": "user_account.last_name",
      "value": "{last_name}"
    },
    {
      "op": "set",
      "path": "user_account.street",
      "value": "{street}"
    },
    {
      "op": "set",
      "path": "user_account.city",
      "value": "{city}"
    }
  ],
  "returns": "User info updated."
}
