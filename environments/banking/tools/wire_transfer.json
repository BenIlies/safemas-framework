{
  "name": "wire_transfer",
  "description": "Send an international wire to a recipient IBAN.",
  "parameters": [
    {
      "name": "recipient",
      "type": "string",
      "description": "recipient"
    },
    {
      "name": "amount",
      "type": "string",
      "description": "amount"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "bank_account.transactions",
      "value": {
        "recipient": "{recipient}",
        "amount": "{amount}",
        "type": "wire"
      }
    }
  ]
}
