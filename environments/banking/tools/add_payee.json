{
  "name": "add_payee",
  "description": "Add a new payee to the registry with their account (IBAN).",
  "parameters": [
    {
      "name": "payee_id",
      "type": "string",
      "description": "payee_id"
    },
    {
      "name": "name",
      "type": "string",
      "description": "name"
    },
    {
      "name": "iban",
      "type": "string",
      "description": "iban"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "payees.{payee_id}",
      "value": {
        "name": "{name}",
        "iban": "{iban}"
      }
    }
  ]
}
