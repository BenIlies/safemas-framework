{
  "name": "correct_iban",
  "description": "Correct the iban recorded on file for a payout_accounts.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "iban",
      "type": "string",
      "description": "Corrected iban."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "bank_account.payout_accounts.{record_id}.iban",
      "value": "{iban}"
    }
  ],
  "returns": "Updated iban on {record_id}."
}
