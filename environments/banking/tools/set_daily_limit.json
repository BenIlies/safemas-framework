{
  "name": "set_daily_limit",
  "description": "Set a card's daily spending limit.",
  "parameters": [
    {
      "name": "card_id",
      "type": "string",
      "description": "card_id"
    },
    {
      "name": "amount",
      "type": "string",
      "description": "amount"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "cards.{card_id}.daily_limit",
      "value": "{amount}"
    }
  ]
}
