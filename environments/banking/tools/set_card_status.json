{
  "name": "set_card_status",
  "description": "Set a card's status (active / frozen).",
  "parameters": [
    {
      "name": "card_id",
      "type": "string",
      "description": "card_id"
    },
    {
      "name": "status",
      "type": "string",
      "description": "status"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "cards.{card_id}.status",
      "value": "{status}"
    }
  ]
}
