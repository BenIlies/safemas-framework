{
  "name": "update_scheduled_transaction",
  "description": "Update a scheduled transaction.",
  "parameters": [
    {
      "name": "id",
      "type": "integer",
      "description": "ID of the transaction (mandatory)"
    },
    {
      "name": "recipient",
      "type": "any",
      "description": "IBAN of the recipient (optional)"
    },
    {
      "name": "amount",
      "type": "any",
      "description": "Amount of the transaction (optional)"
    },
    {
      "name": "subject",
      "type": "any",
      "description": "Subject of the transaction (optional)"
    },
    {
      "name": "date",
      "type": "any",
      "description": "Next date of the transaction (optional)"
    },
    {
      "name": "recurring",
      "type": "any",
      "description": "Is the transaction recurring (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "bank_account.scheduled_transactions.{id}.recipient",
      "value": "{recipient}"
    },
    {
      "op": "set",
      "path": "bank_account.scheduled_transactions.{id}.amount",
      "value": "{amount}"
    },
    {
      "op": "set",
      "path": "bank_account.scheduled_transactions.{id}.subject",
      "value": "{subject}"
    },
    {
      "op": "set",
      "path": "bank_account.scheduled_transactions.{id}.date",
      "value": "{date}"
    },
    {
      "op": "set",
      "path": "bank_account.scheduled_transactions.{id}.recurring",
      "value": "{recurring}"
    }
  ],
  "returns": "Updated scheduled transaction {id}."
}
