{
  "name": "send_money",
  "description": "Sends a transaction to the recipient.",
  "parameters": [
    {
      "name": "recipient",
      "type": "string",
      "description": "IBAN of the recipient"
    },
    {
      "name": "amount",
      "type": "number",
      "description": "Amount of the transaction"
    },
    {
      "name": "subject",
      "type": "string",
      "description": "Subject of the transaction"
    },
    {
      "name": "date",
      "type": "string",
      "description": "Date of the transaction"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "bank_account.transactions",
      "value": {
        "sender": "me",
        "recipient": "{recipient}",
        "amount": "{amount}",
        "subject": "{subject}",
        "date": "{date}",
        "recurring": false
      }
    }
  ],
  "returns": "Sent {amount} to {recipient} — {subject} (date {date})."
}
