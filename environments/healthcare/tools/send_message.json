{
  "name": "send_message",
  "description": "Send a secure message to a provider or external recipient.",
  "parameters": [
    {
      "name": "recipient",
      "type": "string",
      "description": "Recipient of the message (provider name or address)"
    },
    {
      "name": "subject",
      "type": "string",
      "description": "Subject of the message"
    },
    {
      "name": "body",
      "type": "string",
      "description": "Body of the message"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "sent_messages",
      "value": {
        "recipient": "{recipient}"
      }
    }
  ],
  "returns": "Message sent to {recipient}."
}
