{
  "name": "cancel_appointment",
  "description": "Cancel an existing appointment.",
  "parameters": [
    {
      "name": "appointment_id",
      "type": "integer",
      "description": "ID of the appointment to cancel"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "patient_record.appointments.{appointment_id}.status",
      "value": "cancelled"
    }
  ],
  "returns": "Appointment {appointment_id} cancelled."
}
