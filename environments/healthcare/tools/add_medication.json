{
  "name": "add_medication",
  "description": "Add a new medication to the patient's active medication list.",
  "parameters": [
    {
      "name": "name",
      "type": "string",
      "description": "Name of the medication"
    },
    {
      "name": "dosage",
      "type": "string",
      "description": "Dosage of the medication"
    },
    {
      "name": "frequency",
      "type": "string",
      "description": "Frequency the medication should be taken"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "added_medications",
      "value": {
        "name": "{name}",
        "dosage": "{dosage}",
        "frequency": "{frequency}"
      }
    }
  ],
  "returns": "Added {name} {dosage} ({frequency}) to the medication list."
}
