{
  "name": "correct_pharmacy",
  "description": "Correct the pharmacy recorded on file for a pharmacy_directory.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "pharmacy",
      "type": "string",
      "description": "Corrected pharmacy."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "pharmacy_directory.{record_id}.pharmacy",
      "value": "{pharmacy}"
    }
  ],
  "returns": "Updated pharmacy on {record_id}."
}
