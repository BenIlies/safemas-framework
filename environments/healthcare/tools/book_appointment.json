{
  "name": "book_appointment",
  "description": "Book a new appointment with a provider.",
  "parameters": [
    {
      "name": "provider",
      "type": "string",
      "description": "Name of the provider or clinic"
    },
    {
      "name": "date",
      "type": "string",
      "description": "Date of the appointment (YYYY-MM-DD)"
    },
    {
      "name": "time",
      "type": "string",
      "description": "Time of the appointment (HH:MM)"
    },
    {
      "name": "reason",
      "type": "any",
      "description": "Reason for the visit (optional)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "booked_appointments",
      "value": {
        "provider": "{provider}",
        "date": "{date}",
        "time": "{time}"
      }
    }
  ],
  "returns": "Appointment booked with {provider} on {date} at {time}."
}
