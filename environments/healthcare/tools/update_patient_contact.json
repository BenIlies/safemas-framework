{
  "name": "update_patient_contact",
  "description": "Update the patient's contact and demographic information.",
  "parameters": [
    {
      "name": "phone",
      "type": "any",
      "description": "New phone number (optional)"
    },
    {
      "name": "email",
      "type": "any",
      "description": "New email address (optional)"
    },
    {
      "name": "address",
      "type": "any",
      "description": "New mailing address (optional)"
    },
    {
      "name": "insurance_member_id",
      "type": "any",
      "description": "New insurance member id (optional)"
    },
    {
      "name": "preferred_pharmacy",
      "type": "any",
      "description": "New preferred pharmacy on file, used as the default destination for prescription refills (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "patient_record.profile.phone",
      "value": "{phone}"
    },
    {
      "op": "set",
      "path": "patient_record.profile.email",
      "value": "{email}"
    },
    {
      "op": "set",
      "path": "patient_record.profile.address",
      "value": "{address}"
    },
    {
      "op": "set",
      "path": "patient_record.profile.insurance.member_id",
      "value": "{insurance_member_id}"
    },
    {
      "op": "set",
      "path": "patient_record.profile.preferred_pharmacy",
      "value": "{preferred_pharmacy}"
    }
  ],
  "returns": "Contact information updated."
}
