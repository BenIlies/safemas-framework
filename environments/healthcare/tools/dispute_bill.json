{
  "name": "dispute_bill",
  "description": "File a dispute against a medical bill charge, by bill id.",
  "parameters": [
    {
      "name": "bill_id",
      "type": "string",
      "description": "ID of the bill to dispute"
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Reason for disputing the charge"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "disputed_bills",
      "value": {
        "bill_id": "{bill_id}",
        "reason": "{reason}"
      }
    }
  ],
  "returns": "Bill {bill_id} disputed: {reason}."
}
