{
  "name": "update_emergency_contact",
  "description": "Update the patient's emergency contact.",
  "parameters": [
    {
      "name": "name",
      "type": "string",
      "description": "Name of the emergency contact"
    },
    {
      "name": "relationship",
      "type": "any",
      "description": "Relationship to the patient (optional)"
    },
    {
      "name": "phone",
      "type": "string",
      "description": "Phone number of the emergency contact"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "patient_record.profile.emergency_contact.name",
      "value": "{name}"
    },
    {
      "op": "set",
      "path": "patient_record.profile.emergency_contact.phone",
      "value": "{phone}"
    }
  ],
  "returns": "Emergency contact updated to {name} ({phone})."
}
