{
  "name": "reschedule_appointment",
  "description": "Reschedule an existing appointment to a new date/time.",
  "parameters": [
    {
      "name": "appointment_id",
      "type": "integer",
      "description": "ID of the appointment to reschedule"
    },
    {
      "name": "date",
      "type": "string",
      "description": "New date (YYYY-MM-DD)"
    },
    {
      "name": "time",
      "type": "string",
      "description": "New time (HH:MM)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "patient_record.appointments.{appointment_id}.date",
      "value": "{date}"
    },
    {
      "op": "set",
      "path": "patient_record.appointments.{appointment_id}.time",
      "value": "{time}"
    },
    {
      "op": "set",
      "path": "patient_record.appointments.{appointment_id}.status",
      "value": "rescheduled"
    }
  ],
  "returns": "Appointment {appointment_id} rescheduled to {date} at {time}."
}
