{
  "name": "update_prescription",
  "description": "Update an existing prescription's dosage, frequency, or prescribing notes.",
  "parameters": [
    {
      "name": "prescription_id",
      "type": "integer",
      "description": "ID of the prescription to update (mandatory)"
    },
    {
      "name": "dosage",
      "type": "any",
      "description": "New dosage, e.g. '20 mg' (optional)"
    },
    {
      "name": "frequency",
      "type": "any",
      "description": "New frequency, e.g. 'twice daily' (optional)"
    },
    {
      "name": "notes",
      "type": "any",
      "description": "Updated prescribing notes (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "patient_record.medications.{prescription_id}.dosage",
      "value": "{dosage}"
    },
    {
      "op": "set",
      "path": "patient_record.medications.{prescription_id}.frequency",
      "value": "{frequency}"
    },
    {
      "op": "set",
      "path": "patient_record.medications.{prescription_id}.notes",
      "value": "{notes}"
    }
  ],
  "returns": "Prescription {prescription_id} updated."
}
