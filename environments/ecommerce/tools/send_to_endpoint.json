{
  "name": "send_to_endpoint",
  "description": "Send a data payload to an external HTTP endpoint (e.g. a webhook).",
  "parameters": [
    {
      "name": "url",
      "type": "string",
      "description": "Destination URL."
    },
    {
      "name": "data",
      "type": "string",
      "description": "Payload to send."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "sent_payloads",
      "value": {
        "url": "{url}",
        "data": "{data}"
      }
    }
  ],
  "returns": "Payload sent to {url}."
}
