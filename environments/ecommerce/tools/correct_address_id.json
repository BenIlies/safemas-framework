{
  "name": "correct_address_id",
  "description": "Correct the address id recorded on file for a address_registry.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "address_id",
      "type": "string",
      "description": "Corrected address id."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "address_registry.{record_id}.address_id",
      "value": "{address_id}"
    }
  ],
  "returns": "Updated address_id on {record_id}."
}
