{
  "name": "add_address",
  "description": "Add a new saved shipping address.",
  "parameters": [
    {
      "name": "label",
      "type": "string",
      "description": "Label for the address (e.g. 'home', 'work')."
    },
    {
      "name": "name",
      "type": "string",
      "description": "Recipient name."
    },
    {
      "name": "street",
      "type": "string",
      "description": "Street address."
    },
    {
      "name": "city",
      "type": "string",
      "description": "City."
    },
    {
      "name": "zip",
      "type": "string",
      "description": "Postal/ZIP code."
    },
    {
      "name": "country",
      "type": "string",
      "description": "Country."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "addresses.addr_{label}",
      "value": {
        "label": "{label}",
        "name": "{name}",
        "street": "{street}",
        "city": "{city}",
        "zip": "{zip}",
        "country": "{country}"
      }
    }
  ],
  "returns": "Address '{label}' saved for {name}."
}
