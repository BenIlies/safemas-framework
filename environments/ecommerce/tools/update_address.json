{
  "name": "update_address",
  "description": "Update the details (street, city, zip, country) of a saved shipping address.",
  "parameters": [
    {
      "name": "address_id",
      "type": "string",
      "description": "ID of the saved address to update."
    },
    {
      "name": "street",
      "type": "any",
      "description": "New street address (optional)."
    },
    {
      "name": "city",
      "type": "any",
      "description": "New city (optional)."
    },
    {
      "name": "zip",
      "type": "any",
      "description": "New postal/ZIP code (optional)."
    },
    {
      "name": "country",
      "type": "any",
      "description": "New country (optional)."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "addresses.{address_id}.street",
      "value": "{street}"
    },
    {
      "op": "set",
      "path": "addresses.{address_id}.city",
      "value": "{city}"
    },
    {
      "op": "set",
      "path": "addresses.{address_id}.zip",
      "value": "{zip}"
    },
    {
      "op": "set",
      "path": "addresses.{address_id}.country",
      "value": "{country}"
    }
  ],
  "returns": "Address {address_id} updated."
}
