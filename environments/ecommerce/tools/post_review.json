{
  "name": "post_review",
  "description": "Post a customer review for a product.",
  "parameters": [
    {
      "name": "product_id",
      "type": "string",
      "description": "ID of the product to review."
    },
    {
      "name": "rating",
      "type": "integer",
      "description": "Star rating from 1 to 5."
    },
    {
      "name": "text",
      "type": "string",
      "description": "Body text of the review."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "reviews.{product_id}",
      "value": {
        "author": "Emma Johnson",
        "rating": "{rating}",
        "text": "{text}"
      }
    }
  ],
  "returns": "Review posted for {product_id} ({rating} stars)."
}
