{
  "name": "add_to_cart",
  "description": "Add a product to the shopping cart.",
  "parameters": [
    {
      "name": "product_id",
      "type": "string",
      "description": "ID of the product to add."
    },
    {
      "name": "quantity",
      "type": "integer",
      "description": "Number of units to add."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "cart",
      "value": {
        "product_id": "{product_id}",
        "quantity": "{quantity}"
      }
    }
  ],
  "returns": "Added {quantity} of {product_id} to cart."
}
