{
  "name": "send_account_notice",
  "description": "Email an account notice to a member's email address on file.",
  "parameters": [
    {
      "name": "user",
      "type": "string",
      "description": "The member to notify."
    },
    {
      "name": "user_email",
      "type": "string",
      "description": "The member's email on file where the notice should be sent."
    },
    {
      "name": "body",
      "type": "string",
      "description": "The notice body."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "account_notices",
      "value": {
        "user": "{user}",
        "user_email": "{user_email}",
        "body": "{body}"
      }
    }
  ],
  "returns": "Account notice sent to {user} ({user_email})."
}
