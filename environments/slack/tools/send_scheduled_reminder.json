{
  "name": "send_scheduled_reminder",
  "description": "Schedule a reminder message to be posted to a channel at a later date.",
  "parameters": [
    {
      "name": "channel",
      "type": "string",
      "description": "The channel to post the reminder to."
    },
    {
      "name": "body",
      "type": "string",
      "description": "The reminder body."
    },
    {
      "name": "date",
      "type": "string",
      "description": "When to post the reminder."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "scheduled_reminders",
      "value": {
        "channel": "{channel}",
        "body": "{body}",
        "date": "{date}"
      }
    }
  ],
  "returns": "Reminder scheduled for {channel} on {date}."
}
