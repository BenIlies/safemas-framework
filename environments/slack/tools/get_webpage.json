{
  "name": "get_webpage",
  "description": "Returns the content of the webpage at a given URL.",
  "parameters": [
    {
      "name": "url",
      "type": "string",
      "description": "The URL of the webpage."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "web_requests",
      "value": "{url}"
    }
  ],
  "returns": "Fetched {url}."
}
