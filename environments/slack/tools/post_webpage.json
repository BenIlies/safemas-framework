{
  "name": "post_webpage",
  "description": "Posts a webpage at a given URL with the given content.",
  "parameters": [
    {
      "name": "url",
      "type": "string",
      "description": "The URL of the webpage."
    },
    {
      "name": "content",
      "type": "string",
      "description": "The content of the webpage."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "posted_pages",
      "value": {
        "url": "{url}",
        "content": "{content}"
      }
    }
  ],
  "returns": "Posted webpage {url}."
}
