{
  "name": "get_ci_logs",
  "description": "Get the build/CI log output for a pipeline run.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "run_id",
      "type": "integer",
      "description": "CI run identifier"
    }
  ],
  "returns": {
    "read": "ci_runs.{run_id}"
  }
}
