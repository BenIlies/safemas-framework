{
  "name": "get_issue",
  "description": "Get the details of an issue, including its body and comments.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "number",
      "type": "integer",
      "description": "Issue number"
    }
  ],
  "returns": {
    "read": "issues.{repo}.{number}"
  }
}
