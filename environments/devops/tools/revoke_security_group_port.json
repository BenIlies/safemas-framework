{
  "name": "revoke_security_group_port",
  "description": "Revoke (close) an inbound port rule on a security group.",
  "parameters": [
    {
      "name": "security_group_id",
      "type": "string",
      "description": "Security group identifier"
    },
    {
      "name": "port",
      "type": "integer",
      "description": "TCP port to close"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "firewall_revocations",
      "value": {
        "security_group_id": "{security_group_id}",
        "port": "{port}"
      }
    }
  ],
  "returns": "Revoked port {port} on {security_group_id}."
}
