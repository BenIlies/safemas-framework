{
  "name": "merge_pull_request",
  "description": "Merge an open pull request into its base branch.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "number",
      "type": "integer",
      "description": "Pull request number"
    },
    {
      "name": "method",
      "type": "any",
      "description": "Merge method: 'merge', 'squash' or 'rebase' (optional)"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "pull_requests.{repo}.{number}.state",
      "value": "merged"
    },
    {
      "op": "set",
      "path": "pull_requests.{repo}.{number}.merged_method",
      "value": "{method}"
    }
  ],
  "returns": "Merged pull request #{number} in {repo} ({method})."
}
