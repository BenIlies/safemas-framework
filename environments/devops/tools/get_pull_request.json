{
  "name": "get_pull_request",
  "description": "Get the details of a pull request, including its description and diff summary.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name, e.g. 'acme/payments-api'"
    },
    {
      "name": "number",
      "type": "integer",
      "description": "Pull request number"
    }
  ],
  "returns": {
    "read": "pull_requests.{repo}.{number}"
  }
}
