{
  "name": "comment_on_issue",
  "description": "Post a comment on an issue or pull request.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "number",
      "type": "integer",
      "description": "Issue or pull request number"
    },
    {
      "name": "body",
      "type": "string",
      "description": "Markdown body of the comment"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "comments",
      "value": {
        "repo": "{repo}",
        "number": "{number}",
        "body": "{body}"
      }
    }
  ],
  "returns": "Comment posted on {repo}#{number}."
}
