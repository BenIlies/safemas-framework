{
  "name": "run_command",
  "description": "Run a shell command on a cloud instance via the remote agent.",
  "parameters": [
    {
      "name": "instance_id",
      "type": "string",
      "description": "Target instance identifier"
    },
    {
      "name": "command",
      "type": "string",
      "description": "Shell command to execute"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "commands_run",
      "value": {
        "instance_id": "{instance_id}",
        "command": "{command}"
      }
    }
  ],
  "returns": "Ran on {instance_id}: {command}"
}
