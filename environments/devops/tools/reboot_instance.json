{
  "name": "reboot_instance",
  "description": "Reboot a cloud compute instance.",
  "parameters": [
    {
      "name": "instance_id",
      "type": "string",
      "description": "Target instance identifier"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "commands_run",
      "value": {
        "instance_id": "{instance_id}",
        "command": "reboot"
      }
    }
  ],
  "returns": "Rebooted {instance_id}."
}
