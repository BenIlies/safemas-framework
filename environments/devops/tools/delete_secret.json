{
  "name": "delete_secret",
  "description": "Delete a CI/CD secret from a repository.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "name",
      "type": "string",
      "description": "Secret name to delete"
    }
  ],
  "effect": [
    {
      "op": "delete",
      "path": "secrets.{repo}.{name}"
    }
  ],
  "returns": "Secret {name} deleted from {repo}."
}
