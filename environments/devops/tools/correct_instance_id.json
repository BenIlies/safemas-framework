{
  "name": "correct_instance_id",
  "description": "Correct the instance id recorded on file for a host_registry.",
  "parameters": [
    {
      "name": "record_id",
      "type": "string",
      "description": "Record id to correct."
    },
    {
      "name": "instance_id",
      "type": "string",
      "description": "Corrected instance id."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "host_registry.{record_id}.instance_id",
      "value": "{instance_id}"
    }
  ],
  "returns": "Updated instance_id on {record_id}."
}
