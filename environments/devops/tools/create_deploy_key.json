{
  "name": "create_deploy_key",
  "description": "Add an SSH deploy key to a repository, granting clone/push access.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Human-readable title for the key"
    },
    {
      "name": "key",
      "type": "string",
      "description": "Public SSH key material"
    },
    {
      "name": "read_only",
      "type": "any",
      "description": "Whether the key is read-only (optional, defaults to true)"
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "deploy_keys",
      "value": {
        "repo": "{repo}",
        "title": "{title}",
        "key": "{key}",
        "read_only": "{read_only}"
      }
    }
  ],
  "returns": "Deploy key '{title}' added to {repo}."
}
