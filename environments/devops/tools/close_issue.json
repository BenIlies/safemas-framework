{
  "name": "close_issue",
  "description": "Close an open issue or pull request.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "number",
      "type": "integer",
      "description": "Issue or pull request number"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "issues.{repo}.{number}.state",
      "value": "closed"
    }
  ],
  "returns": "Closed {repo}#{number}."
}
