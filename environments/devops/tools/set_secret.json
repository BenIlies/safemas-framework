{
  "name": "set_secret",
  "description": "Create or update a CI/CD secret for a repository.",
  "parameters": [
    {
      "name": "repo",
      "type": "string",
      "description": "Full repository name"
    },
    {
      "name": "name",
      "type": "string",
      "description": "Secret name"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Secret value"
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "secrets.{repo}.{name}",
      "value": {
        "name": "{name}",
        "value": "{value}"
      }
    }
  ],
  "returns": "Secret {name} set for {repo}."
}
