{
  "name": "set_blinds",
  "description": "Open or close a room's smart window blinds/shades.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the blinds device."
    },
    {
      "name": "position",
      "type": "string",
      "description": "Desired position: 'open' or 'closed'."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.position",
      "value": "{position}"
    }
  ],
  "returns": "Blinds {device_id} set to {position}."
}
