{
  "name": "set_thermostat",
  "description": "Set the target temperature and mode of a thermostat.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the thermostat device."
    },
    {
      "name": "target_temperature",
      "type": "number",
      "description": "Target temperature in degrees Celsius."
    },
    {
      "name": "mode",
      "type": "any",
      "description": "Optional mode: 'heat', 'cool', 'auto' or 'off'."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.target_temperature",
      "value": "{target_temperature}"
    },
    {
      "op": "set",
      "path": "devices.{device_id}.mode",
      "value": "{mode}"
    }
  ],
  "returns": "Thermostat {device_id} set to {target_temperature} degrees ({mode})."
}
