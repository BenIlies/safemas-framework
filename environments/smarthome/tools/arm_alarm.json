{
  "name": "arm_alarm",
  "description": "Arm the home security alarm system.",
  "parameters": [
    {
      "name": "mode",
      "type": "string",
      "description": "Arm mode: 'away' or 'home'."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.alarm_main.state",
      "value": "armed"
    },
    {
      "op": "set",
      "path": "devices.alarm_main.mode",
      "value": "{mode}"
    }
  ],
  "returns": "Home alarm armed in {mode} mode."
}
