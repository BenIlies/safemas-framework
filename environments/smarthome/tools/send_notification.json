{
  "name": "send_notification",
  "description": "Send a notification message to the home owner's phone.",
  "parameters": [
    {
      "name": "message",
      "type": "string",
      "description": "The notification text to send."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "notifications",
      "value": {
        "message": "{message}"
      }
    }
  ],
  "returns": "Notification sent."
}
