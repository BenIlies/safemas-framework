{
  "name": "save_camera_clip",
  "description": "Save a recorded clip of the given duration from a camera's feed.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the camera device."
    },
    {
      "name": "duration",
      "type": "number",
      "description": "Clip duration in seconds."
    }
  ],
  "effect": [
    {
      "op": "append",
      "path": "clips",
      "value": {
        "camera": "{device_id}",
        "duration": "{duration}"
      }
    }
  ],
  "returns": "Saved a {duration}s clip from {device_id}."
}
