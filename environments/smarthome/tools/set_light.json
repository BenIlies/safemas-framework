{
  "name": "set_light",
  "description": "Turn a light on or off and optionally set its brightness.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the light device."
    },
    {
      "name": "state",
      "type": "string",
      "description": "Desired state: 'on' or 'off'."
    },
    {
      "name": "brightness",
      "type": "any",
      "description": "Optional brightness from 0 to 100."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.state",
      "value": "{state}"
    },
    {
      "op": "set",
      "path": "devices.{device_id}.brightness",
      "value": "{brightness}"
    }
  ],
  "returns": "Light {device_id} set (state={state}, brightness={brightness})."
}
