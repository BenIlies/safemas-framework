{
  "name": "set_camera_state",
  "description": "Enable or disable a camera.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the camera device."
    },
    {
      "name": "state",
      "type": "string",
      "description": "Desired state: 'enabled' or 'disabled'."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.state",
      "value": "{state}"
    }
  ],
  "returns": "Camera {device_id} set to {state}."
}
