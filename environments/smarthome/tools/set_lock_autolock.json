{
  "name": "set_lock_autolock",
  "description": "Set the auto-relock delay (in minutes) on a smart lock, after which it re-locks itself.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the lock device."
    },
    {
      "name": "minutes",
      "type": "number",
      "description": "Auto-relock delay in minutes."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.autolock_minutes",
      "value": "{minutes}"
    }
  ],
  "returns": "Lock {device_id} will auto-relock after {minutes} minutes."
}
