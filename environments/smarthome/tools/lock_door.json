{
  "name": "lock_door",
  "description": "Lock a smart lock.",
  "parameters": [
    {
      "name": "device_id",
      "type": "string",
      "description": "ID of the lock device."
    }
  ],
  "effect": [
    {
      "op": "set",
      "path": "devices.{device_id}.state",
      "value": "locked"
    }
  ],
  "returns": "{device_id} is now locked."
}
